---
import Base from '../../layouts/Base.astro';
import days from '../../data/days.json';
import { plates } from '../../plates/index.js';
import { LINES } from '../../lib/plate.js';

export function getStaticPaths() {
  return days
    .filter((d) => d.status === 'published' && plates[d.day])
    .map((d) => ({ params: { slug: `day${String(d.day).padStart(2, '0')}` }, props: { d } }));
}

const { d } = Astro.props;
const base = import.meta.env.BASE_URL;
const p = plates[d.day];
const both = (variant) => ({ gray: p.render({ variant }), color: p.render({ mode: 'color', variant }) });
const maps = both('map');
const charts = both('chart');
const insets = p.page.inset ? both('inset') : null; // a page without an inset gives the chart the whole column (Plate XIV)
// Column widths, as multiples of the column height. On Plate I the map column is as wide as the map
// draws at full height and the middle column as wide as the chart plus a ~330-unit inset would draw
// at full height; the story takes the rest. Every page keeps Plate I's story width: its map column
// is as wide as its map draws at full height, and its middle column takes the rest of the width
// Plate I's two columns take (the chart scales with the column; the inset fills what is left).
const vb = (svg) => svg.match(/viewBox="([^"]+)"/)[1].split(' ').map(Number);
const ratios = (map, chart) => {
  const [, , mw, mh] = vb(map), [, , cw, ch] = vb(chart);
  return [mw / mh, cw / (ch + 330 + 70)]; // + HTML headers and notes
};
const [mapRatio, sideRatio] = (() => {
  const [m, s] = ratios(maps.gray, charts.gray);
  const [m1, s1] = d.day === 1 ? [m, s] : ratios(plates[1].render({ variant: 'map' }), plates[1].render({ variant: 'chart' }));
  return [m.toFixed(4), (m1 + s1 - m).toFixed(4)];
})();
// Tooltip line boxes take the line's color in color mode, as in the chart.
const lineCss = Object.entries(LINES).map(([k, c]) => `html[data-mode='color'] .tt-line[data-line='${k}'] { background: ${c}; color: #fff; }`).join('\n');
const pad = (n) => String(n).padStart(2, '0');
const slug = (n) => `day${pad(n)}`;
const published = days.filter((x) => x.status === 'published' && plates[x.day]).map((x) => x.day);
const prev = published.filter((n) => n < d.day).at(-1);
const next = published.find((n) => n > d.day);
const chapters = ['The Grid', 'The Systems', 'The Gaps', 'The Body', 'The Possible'];
const numerals = ['I', 'II', 'III', 'IV', 'V'];
const chapter = `Chapter ${numerals[chapters.indexOf(d.chapter)]}: ${d.chapter}`;
const date = new Date(d.date + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const dl = `${base}downloads/${p.file}`;
// story sections in panel order: a plate's own list (story.sections: [heading, paragraphs, open?]),
// or Background, Findings (open) and The plan
const sections = p.story.sections ?? [['Background', p.story.background], ['Findings', p.story.findings, true], ['The plan', p.story.plan]].filter(([, paras]) => paras);
// saved file name, either mode: DAY01-POINTS.svg, DAY01-POINTS.png
const saveName = `DAY${pad(d.day)}-${d.theme.toUpperCase().replace(/[^A-Z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---
<Base title={`Plate ${d.plate} · ${d.title} — 800 to the Mile`} description={p.story.findings[0]} app>
  <nav class="daynav" slot="nav" aria-label="Plates">
    <div class="links sans">
      {prev ? <a class="prev" href={`${base}${slug(prev)}/`}>← Day {pad(prev)}</a> : <span class="prev" />}
      <a href={base}>Home</a>
      {next ? <a class="next" href={`${base}${slug(next)}/`}>Day {pad(next)} →</a> : <span class="next off">Next →</span>}
    </div>
    <p class="where sans quiet">{chapter} · Plate {d.plate}</p>
  </nav>

  <main class="plate-view">
   <div class="cols" style={`--map-ratio: ${mapRatio}; --side-ratio: ${sideRatio}`} data-line-colors={JSON.stringify(LINES)}>
    <figure class="viz map">
      <div class="only-gray" set:html={maps.gray} />
      <div class="only-color" set:html={maps.color} />
      <div class="tip" role="tooltip" hidden></div>
      <div class="mapctl">
        <button type="button" data-map="full" aria-label="Show the map full screen" aria-pressed="false" title="Full screen"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 8V3.5H8M12 3.5h4.5V8M16.5 12v4.5H12M8 16.5H3.5V12"/></svg></button>
      </div>
    </figure>
    <figure class="viz side">
      <div class:list={['chart', { fill: !insets }]}>
        <p class="col-title sans">{p.page.chart.title}</p>
        <p class="col-note">{p.page.chart.note}{p.page.chart.colorNote && <span class="only-color">{p.page.chart.colorNote}</span>}</p>
        <div class="only-gray" set:html={charts.gray} />
        <div class="only-color" set:html={charts.color} />
      </div>
      {insets && (
      <div class="inset">
        <p class="col-title sans">{p.page.inset.title}</p>
        {p.page.inset.note
          ? <p class="col-note">{p.page.inset.note}</p>
          : <p class="col-note">Shown at <span data-inset-scale>×2</span> the scale of the main map.</p>}
        <div class:list={['inset-box', { bare: p.page.inset.frame === false }]}>
          <div class="only-gray" set:html={insets.gray} />
          <div class="only-color" set:html={insets.color} />
        </div>
      </div>
      )}
      <div class="tip" role="tooltip" hidden></div>
    </figure>

    <aside class="panel">
      <p class="meta sans quiet"><span>Day {pad(d.day)} · {d.theme} · {date}</span></p>
      <h1>{d.title}</h1>
      <p class="subtitle">{p.subtitle}</p>
      <p class="finding">{p.finding}</p>

      {sections.map(([heading, paras, open]) => (
        <details name="plate" open={open}>
          <summary class="sans">{heading}</summary>
          <div class="body">{paras.map((t) => <p>{t}</p>)}</div>
        </details>
      ))}
      <details name="plate">
        <summary class="sans">Data and method</summary>
        <dl class="body ledger">
          {p.ledger.map(([k, v, url]) => (
            <Fragment><dt class="sans quiet">{k}</dt><dd>{Array.isArray(v) ? v.map(([t, u], i) => <Fragment>{i > 0 && ' · '}<a href={u}>{t}</a></Fragment>) : url ? <a href={url}>{v}</a> : v}</dd></Fragment>
          ))}
        </dl>
      </details>
      <details name="plate">
        <summary class="sans">Download</summary>
        <ul class="body downloads">
          <li class="only-gray"><a href={`${dl}.svg`} download={`${saveName}.svg`}>Plate {d.plate} (SVG)</a><span class="quiet">Vector, fonts embedded</span></li>
          <li class="only-color"><a href={`${dl}-color.svg`} download={`${saveName}.svg`}>Plate {d.plate} (SVG)</a><span class="quiet">Vector, fonts embedded</span></li>
          <li class="only-gray"><a href={`${dl}.png`} download={`${saveName}.png`}>Plate {d.plate} (PNG)</a><span class="quiet">3240 × 4050 px, 300 DPI</span></li>
          <li class="only-color"><a href={`${dl}-color.png`} download={`${saveName}.png`}>Plate {d.plate} (PNG)</a><span class="quiet">3240 × 4050 px, 300 DPI</span></li>
        </ul>
      </details>
    </aside>
   </div>
  </main>
</Base>

<Fragment set:html={`<style>${lineCss}</style>`} />

<script>
  // Hover hooks emitted by the map, chart and inset variants of each plate renderer:
  //   [data-tip][data-name][data-lines][data-ada][data-detail]  tooltip (a station, or a walkshed with
  //        data-kind=area: dot or ring, line boxes, then detail rows split on '|'); data-shape=square
  //        draws the mark as a filled or hollow square instead (Plate V's stations); ring / half-ring,
  //        the dot inside a full or half outage ring (Plate VII); due / nodate, a station still to be
  //        made accessible, ring with a dot or dashed ring (Plate VIII); tile, a square mile as nested
//        squares sized by data-size and data-frac, and none, no mark (Plate IX); glyph, a block's
  //        overprinted characters, data-glyph, on its color-mode fill, data-fill (Plate X); rings, a
  //        station's sound rings, data-n of them (Plate XI); label, a crowd label's mark, data-type and
  //        data-fill (Plate XIV)
  //   [data-kind=route][data-detail][data-sep][data-dash][data-gray][data-color][data-on-color]
  //        tooltip for a route: route box and name, a rule data-sep px thick, one sentence
  //   [data-kind=street][data-detail][data-band][data-line: 'gray|color' colors, empty for none]
  //        tooltip for a street (Plate VI): name, a band / line swatch as the map legend, one sentence
  //   [data-kind=cluster][data-rank][data-ca][data-total][data-walk][data-bike][data-kw][data-kb][data-colors: 'gray four | color four']
  //        tooltip for a cluster (Plate IV): number box, name and area, total, a walking / biking bar
  //        with the deaths as dots under their part of it, the counts, then the detail rows
  //   [data-kind=sheet][data-sheet: JSON {num, name, sub, fill, on, blocks}]
  //        a structured tooltip (Plate XII): a header shaded in the item's map colour (fill, text in
  //        on) with a number box as Plate IV's; then blocks: {sec} small-caps section, {bar: [[frac,
  //        colour|'hatch'], ...]} a 100% bar, {row: [label, value, note?]} right-aligned figures,
  //        {foot} a closing line in pencil
  //   [data-kind=card][data-card: JSON {name, aside?, mark?: {type, fill}, big?: [value, text],
  //        bar?: {frac, segs: [[from, to, fill]], left, right}, sev?: [level, of], chips?: [..],
  //        sec?, counts?: [{type, fill, n, label}], foot?: [left, right]}]
  //        a compact card (Plate XIV): one number and a filled bar in the map's own shades, label
  //        marks with counts, severity pips, tags, a status footer
  //   [data-kind=ruler][data-vals: 'a b'][data-aside?], its drawing's svg [data-ruler: JSON {max,
  //        segs: [[from, to, fill]], ticks: [..], foot: [dot label, square label, note]}]
  //        a minutes ruler (Plate XV): the legend's classes as a strip from 0 to max, a dot pin above
  //        for the first value and a square pin below for the second
  //   [data-kind=hours][data-vals: 24 counts][data-at][data-detail]
  //        a block's day (Plate XVII): the count at the hour shown (the chart's hour if one is picked,
  //        else data-at) as a big number, the 24 hours as bars with that hour in ink, then detail rows
  //   [data-hl] (chart row) / [data-keys] (station, label)  highlight one line set, fade the rest
  // Highlighting spans every page SVG, so a line row in the chart lights its stations on the map.
  const cols = document.querySelector<HTMLElement>('.cols');
  const visible = (sel: string) =>
    [...document.querySelectorAll<SVGSVGElement>(sel)].filter((el) => el.getBoundingClientRect().width > 0);
  const scale = (svg: SVGSVGElement, slice = false) => {
    const r = svg.getBoundingClientRect();
    const vb = svg.viewBox.baseVal;
    return (slice ? Math.max : Math.min)(r.width / vb.width, r.height / vb.height);
  };

  // Set the chart title on the same line as the top of the map's grid labels, then state the
  // inset's scale relative to the map. The map SVG gives, in viewBox units from its top: data-top (grid
  // labels), data-ftop (map field), data-bottom (bottom grid line); and data-ppm, px per mile.
  const chartBox = document.querySelector<HTMLElement>('.side .chart');
  const layout = () => {
    const [map] = visible('.map svg');
    const title = chartBox?.querySelector<HTMLElement>('.col-title');
    const [inset] = visible('.inset-box svg');
    const side = document.querySelector<HTMLElement>('.side');
    const insetBox = document.querySelector<HTMLElement>('.inset-box');
    if (chartBox) chartBox.style.marginTop = '';
    if (side) side.style.paddingBottom = '';
    if (map && title && chartBox && !matchMedia('(max-width: 900px)').matches) {
      const mapTop = map.getBoundingClientRect().top + Number(map.dataset.top) * scale(map);
      const r = title.getBoundingClientRect();
      const capTop = r.top + (r.height - parseFloat(getComputedStyle(title).fontSize) * 0.7) / 2; // cap height ≈ 0.7 em
      chartBox.style.marginTop = `${Math.max(-12, mapTop - capTop)}px`;
      // and end the inset box on the map's bottom grid line, unless that leaves the inset shorter
      // than half its width; then it keeps that height and ends below the map
      if (side && insetBox && map.dataset.bottom) {
        const mapBottom = map.getBoundingClientRect().top + Number(map.dataset.bottom) * scale(map);
        const box = insetBox.getBoundingClientRect();
        const gap = Math.min(box.bottom - mapBottom, Math.max(0, box.height - box.width / 2));
        side.style.paddingBottom = `${Math.max(0, parseFloat(getComputedStyle(side).paddingBottom) + gap)}px`;
      }
    }
    // the full-screen button in the top-left corner of the map's field (its left edge is the viewBox's;
    // its top, data-ftop); full screen centres the map, so its left edge moves by half the spare width
    const ctl = document.querySelector<HTMLElement>('.mapctl');
    if (map && ctl && map.dataset.ftop) {
      const r = map.getBoundingClientRect(), f = map.closest('figure')!.getBoundingClientRect();
      const s = scale(map);
      const dx = map.getAttribute('preserveAspectRatio')?.startsWith('xMid') ? (r.width - map.viewBox.baseVal.width * s) / 2 : 0;
      ctl.style.left = `${r.left - f.left + dx + 8}px`;
      ctl.style.top = `${r.top - f.top + Number(map.dataset.ftop) * s + 8}px`;
    }
    const out = document.querySelector('[data-inset-scale]');
    if (map && inset && out && map.dataset.ppm && inset.dataset.ppm) {
      const n = (scale(inset, true) * Number(inset.dataset.ppm)) / (scale(map) * Number(map.dataset.ppm));
      out.textContent = `×${Number(n.toFixed(n < 10 ? 1 : 0))}`;
    }
    // A cropped inset (data-north) shows less than the plate's box: move the map's outline to the
    // miles actually in view, and pin labels marked data-pin-bottom to the crop's bottom edge.
    if (map && inset && map.dataset.ppm && inset.dataset.ppm && inset.dataset.north) {
      const vb = inset.viewBox.baseVal;
      const shown = inset.getBoundingClientRect().height / scale(inset, true); // viewBox units in view
      const top = (vb.height - shown) / 2;
      const ki = Number(inset.dataset.ppm);
      const north = Number(inset.dataset.north) - top / ki;
      const south = north - shown / ki;
      // both modes' maps, so the outline is already right when the mode toggle swaps them
      document.querySelectorAll<SVGRectElement>('.map [data-inset-frame]').forEach((frame) => {
        const k = Number(frame.closest<SVGSVGElement>('svg')?.dataset.ppm);
        const y0 = Number(frame.dataset.y0);
        frame.setAttribute('y', `${y0 - north * k}`);
        frame.setAttribute('height', `${(north - south) * k}`);
      });
      document.querySelectorAll('.inset-box [data-pin-bottom]').forEach((g) => g.setAttribute('transform', `translate(0 ${top + shown})`));
    }
  };
  // Full screen shows the map figure alone, centred on paper.
  const mapFig = document.querySelector<HTMLElement>('.map')!;
  const mapSvgs = [...mapFig.querySelectorAll<SVGSVGElement>(':scope > div:not(.tip):not(.mapctl) > svg')];
  type FsDoc = Document & { webkitFullscreenElement?: Element; webkitExitFullscreen?: () => void; webkitFullscreenEnabled?: boolean };
  type FsEl = HTMLElement & { webkitRequestFullscreen?: () => void };
  const fsDoc = document as FsDoc;
  const full = mapFig.querySelector<HTMLButtonElement>("[data-map='full']")!;
  if (!(fsDoc.fullscreenEnabled || fsDoc.webkitFullscreenEnabled)) full.parentElement!.hidden = true; // e.g. iPhone
  full.addEventListener('click', () => {
    if (fsDoc.fullscreenElement ?? fsDoc.webkitFullscreenElement) (fsDoc.exitFullscreen?.bind(fsDoc) ?? fsDoc.webkitExitFullscreen?.bind(fsDoc))?.();
    else ((mapFig as FsEl).requestFullscreen?.bind(mapFig) ?? (mapFig as FsEl).webkitRequestFullscreen?.bind(mapFig))?.();
  });
  const onFull = () => {
    const on = (fsDoc.fullscreenElement ?? fsDoc.webkitFullscreenElement) === mapFig;
    full.setAttribute('aria-pressed', String(on));
    full.setAttribute('aria-label', on ? 'Leave full screen' : 'Show the map full screen');
    for (const svg of mapSvgs) svg.setAttribute('preserveAspectRatio', on ? 'xMidYMid meet' : 'xMinYMin meet');
    requestAnimationFrame(layout);
  };
  document.addEventListener('fullscreenchange', onFull);
  document.addEventListener('webkitfullscreenchange', onFull);

  layout();
  addEventListener('resize', layout);
  document.fonts?.ready.then(layout);
  document.querySelectorAll('[data-set-mode]').forEach((b) => b.addEventListener('click', () => requestAnimationFrame(layout)));

  // keys: the lines to light, or null to clear.
  const highlight = (keys: string[] | null) => {
    cols?.querySelectorAll('.map > div:not(.tip) > svg, .chart svg, .inset-box svg').forEach((svg) => {
      svg.classList.toggle('hl', Boolean(keys));
      if (!keys) return;
      svg.querySelectorAll('[data-keys]').forEach((n) => n.classList.toggle('on', n.getAttribute('data-keys')!.split(' ').some((k) => keys.includes(k))));
      svg.querySelectorAll('[data-hl]').forEach((n) => n.classList.toggle('on', keys.includes(n.getAttribute('data-hl')!)));
    });
  };
  // A chart row lights its own line; a station on the map or inset lights all of its lines.
  const keysOf = (t: Element) => {
    const h = t.closest('[data-hl]');
    if (h) return [h.getAttribute('data-hl')!];
    const g = t.closest('[data-tip]');
    const lines = g?.getAttribute('data-lines');
    return lines ? lines.split(' ') : null;
  };
  const hoverable = (t: Element) => t.closest('[data-hl], [data-tip][data-lines]');
  // The hovered station grows wherever it appears: map, inset and every chart row it is on.
  // ...and its dot, with its name, is drawn above everything else on the map and inset
  const pick = (id: string | null) => {
    cols?.querySelectorAll('g.pick').forEach((g) => g.classList.remove('pick'));
    if (!id) return;
    cols?.querySelectorAll(`g[data-id="${id}"]`).forEach((g) => g.classList.add('pick'));
    cols?.querySelectorAll(`.map svg [data-id="${id}"], .inset-box svg [data-id="${id}"]`).forEach((el) => {
      el.parentNode?.appendChild(el); // later in the document draws on top
    });
  };

  // The tooltip's dot or ring follows the map: ink in grayscale; in color, the station's line color,
  // or ink for stations on two or more lines.
  const lineColors: Record<string, string> = JSON.parse(cols?.dataset.lineColors ?? '{}');
  const isColor = () => document.documentElement.dataset.mode === 'color';
  // Plate XIV's label marks: ring curb ramp, dot obstacle, cross missing curb ramp, diamond surface
  // problem, bar no sidewalk
  const labelGlyph = (t: string, c: string) => {
    const g = t === 'CurbRamp' ? `<circle cx="5" cy="5" r="3.3" fill="none" stroke="${c}" stroke-width="1.3"/>`
      : t === 'Obstacle' ? `<circle cx="5" cy="5" r="3.2" fill="${c}"/>`
      : t === 'NoCurbRamp' ? `<path d="M1.6,1.6L8.4,8.4M1.6,8.4L8.4,1.6" stroke="${c}" stroke-width="1.8"/>`
      : t === 'SurfaceProblem' ? `<path d="M5,1L9,5L5,9L1,5Z" fill="#fff" stroke="${c}" stroke-width="1.4"/>`
      : `<rect x="1" y="3.6" width="8" height="2.8" fill="${c}"/>`;
    return `<svg viewBox="0 0 10 10" aria-hidden="true">${g}</svg>`;
  };
  const mark = (ada: boolean, lines: string[], shape?: string, ds: DOMStringMap = {}) => {
    const color = isColor();
    const c = color && lines.length === 1 ? lineColors[lines[0]] ?? '#232323' : color ? '#232323' : '#5A5853'; // grayscale marks are softened
    // Plate VII: an accessible station with an elevator out, drawn as on the map: the dot with an ink
    // ring around it, full (data-shape=ring) or its right half (data-shape=half-ring), on a paper disc
    if (shape === 'ring' || shape === 'half-ring') {
      const ring = shape === 'ring'
        ? '<circle r="6.4" fill="none" stroke="#232323" stroke-width="1.44"/>'
        : '<path d="M0,-6.4A6.4,6.4 0 0 1 0,6.4" fill="none" stroke="#232323" stroke-width="1.44"/>';
      return `<svg viewBox="-8 -8 16 16" style="width:16px;height:16px" aria-hidden="true"><circle r="7.84" fill="#F1F0EC"/>${ring}<circle r="3.2" fill="${c}"/></svg>`;
    }
    // Plate VIII: a station still to be made accessible, due by a year (ring with a dot) or with no
    // date (dashed ring)
    if (shape === 'due')
      return `<svg viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="3.6" fill="#F1F0EC" stroke="${c}" stroke-width="1.2"/><circle cx="5" cy="5" r="1.4" fill="${c}"/></svg>`;
    if (shape === 'nodate')
      return `<svg viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="3.6" fill="#F1F0EC" stroke="${c}" stroke-width="1.2" stroke-dasharray="2.2 1.8"/></svg>`;
    // Plate IX: a square mile, drawn as on the map: its class color (data-fill), and in grayscale an
    // ink square for its service (data-frac of the square); a 2-mile ring of the chart (none) has no mark
    if (shape === 'none') return '';
    // Plate X: a block, its characters struck on one spot as on the map (data-glyph)
    if (shape === 'glyph')
      return `<svg viewBox="0 0 10 10" aria-hidden="true">${color && ds.fill ? `<rect width="10" height="10" fill="${ds.fill}"/>` : ''}${[...(ds.glyph ?? '')].map((g) => `<text x="5" y="8.8" font-family="Roboto, sans-serif" font-size="11.5" text-anchor="middle" fill="#232323">${g}</text>`).join('')}</svg>`;
    if (shape === 'tile') {
      const s = 10 * Number(ds.size ?? 1), f = s * Number(ds.frac ?? 0);
      return `<svg viewBox="0 0 10 10" aria-hidden="true"><rect x="${5 - s / 2}" y="${5 - s / 2}" width="${s}" height="${s}" fill="${ds.fill ?? '#BDBBB4'}"/>${f > 0.3 ? `<rect x="${5 - f / 2}" y="${5 - f / 2}" width="${f}" height="${f}" fill="#232323"/>` : ''}</svg>`;
    }
    // Plate XI: a station's sound rings, one per 5 dB above 50 (data-n, drawn up to 3), round the dot or ring
    if (shape === 'rings') {
      const n = Math.min(3, Number(ds.n ?? 0));
      const rings = Array.from({ length: n }, (_, i) => `<circle cx="9" cy="9" r="${(4.6 + 1.5 * (i + 1)).toFixed(1)}" fill="none" stroke="${c}" stroke-width="0.6"/>`).join('');
      const centre = ada ? `<circle cx="9" cy="9" r="3.4" fill="${c}"/>` : `<circle cx="9" cy="9" r="3" fill="#F1F0EC" stroke="${c}" stroke-width="1.2"/>`;
      return `<svg viewBox="0 0 18 18" style="width:16px;height:16px" aria-hidden="true">${rings}${centre}</svg>`;
    }
    // Plate XIV: a crowd label, drawn as on the map: ring curb ramp, dot obstacle, cross missing curb
    // ramp, diamond surface problem, bar no sidewalk (data-type); its colour (data-fill) in color mode
    if (shape === 'label') {
      const t = ds.type ?? '';
      return labelGlyph(t, color ? ds.fill ?? '#232323' : t === 'CurbRamp' ? '#77756F' : '#232323');
    }
    if (shape === 'square')
      return ada
        ? `<svg viewBox="0 0 10 10" aria-hidden="true"><rect x="1.5" y="1.5" width="7" height="7" fill="${c}"/></svg>`
        : `<svg viewBox="0 0 10 10" aria-hidden="true"><rect x="2" y="2" width="6" height="6" fill="#F1F0EC" stroke="${c}" stroke-width="1.2"/></svg>`;
    return ada
      ? `<svg viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="4" fill="${c}"/></svg>`
      : `<svg viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="3.6" fill="#F1F0EC" stroke="${c}" stroke-width="1.2"/></svg>`;
  };

  document.querySelectorAll<HTMLElement>('.viz').forEach((fig) => {
    const tip = fig.querySelector<HTMLElement>('.tip')!;
    const move = (e: PointerEvent) => {
      const r = fig.getBoundingClientRect();
      let x = e.clientX - r.left + 14;
      let y = e.clientY - r.top + 14;
      if (x + tip.offsetWidth > r.width) x -= tip.offsetWidth + 28;
      if (y + tip.offsetHeight > r.height) y -= tip.offsetHeight + 28;
      tip.style.transform = `translate(${x}px, ${y}px)`;
    };
    const show = (g: HTMLElement, e: PointerEvent) => {
      tip.classList.remove('sheet', 'card', 'ruler');
      const route = g.dataset.kind === 'route';
      const head = document.createElement('div');
      head.className = 'tt-head';
      const name = document.createElement('strong');
      name.textContent = g.dataset.name ?? g.dataset.tip ?? '';
      const lines = document.createElement('div');
      lines.className = 'tt-lines';
      for (const l of (g.dataset.lines ?? '').split(' ').filter(Boolean)) {
        const box = document.createElement('span');
        box.className = 'tt-line';
        box.dataset.line = l;
        box.textContent = l;
        if (route && isColor() && g.dataset.color) Object.assign(box.style, { background: g.dataset.color, color: g.dataset.onColor ?? '#fff' });
        lines.append(box);
      }
      if (route) {
        // route box, then name; a rule as thick as the route's riders; then one sentence
        head.append(...lines.children, name);
        const c = (isColor() ? g.dataset.color : g.dataset.gray) ?? '#232323';
        const w = g.dataset.sep ?? '2';
        const rule = document.createElement('div');
        rule.className = 'tt-sep';
        rule.innerHTML = `<svg viewBox="0 0 200 9" preserveAspectRatio="none" aria-hidden="true"><line x1="0" x2="200" y1="4.5" y2="4.5" stroke="${c}" stroke-width="${w}"${g.dataset.dash ? ' stroke-dasharray="6 4"' : ''} vector-effect="non-scaling-stroke"/></svg>`;
        const text = document.createElement('span');
        text.className = 'tt-detail';
        text.textContent = g.dataset.detail ?? '';
        tip.replaceChildren(head, rule, text);
        tip.hidden = false;
        move(e);
        return;
      }
      if (g.dataset.kind === 'street') {
        // a street (Plate VI): its name, a swatch drawn as the map legend draws it (band, line in band,
        // or line), then one sentence
        head.append(name);
        const pick = (pair?: string) => (pair ? pair.split('|')[isColor() ? 1 : 0] : '');
        const band = pick(g.dataset.band), stroke = pick(g.dataset.line);
        const sw = document.createElement('div');
        sw.className = 'tt-sep';
        sw.innerHTML = `<svg viewBox="0 0 200 9" preserveAspectRatio="none" aria-hidden="true">${band ? `<rect width="200" height="9" fill="${band}"/>` : ''}${stroke ? `<line x1="0" x2="200" y1="4.5" y2="4.5" stroke="${stroke}" stroke-width="2" vector-effect="non-scaling-stroke"/>` : ''}</svg>`;
        const text = document.createElement('span');
        text.className = 'tt-detail';
        text.textContent = g.dataset.detail ?? '';
        tip.replaceChildren(head, sw, text);
        tip.hidden = false;
        move(e);
        return;
      }
      if (g.dataset.kind === 'ruler') {
        type Ruler = { max: number; segs: [number, number, string][]; ticks?: number[]; foot?: [string, string, string?] };
        let r: Ruler;
        try { r = JSON.parse(g.closest('svg')?.dataset.ruler ?? ''); } catch { return; }
        const [a, b] = (g.dataset.vals ?? '').split(' ').map(Number);
        const W = 212, top = 20, h = 9, k = W / r.max;
        const at = (v: number) => Math.min(v, r.max - 0.5) * k;
        const t = (x: number, y: number, s: string | number, anchor = 'start') =>
          `<text x="${x.toFixed(1)}" y="${y}" text-anchor="${anchor}" font-family="Roboto, sans-serif" font-size="12" font-weight="600" fill="#232323">${s}</text>`;
        // the classes, a hair apart so the pale ones stay distinct; short ticks under the strip
        let s = r.segs.map(([s0, s1, c]) => `<rect x="${(s0 * k + 0.5).toFixed(1)}" y="${top}" width="${Math.max(0, (s1 - s0) * k - 1).toFixed(1)}" height="${h}" fill="${c}"/>`).join('');
        s += (r.ticks ?? []).map((v) => `<line x1="${(v * k).toFixed(1)}" x2="${(v * k).toFixed(1)}" y1="${top + h + 1}" y2="${top + h + 4}" stroke="#77756F" stroke-width="1"/>`).join('');
        const ax = at(a), bx = at(b), aEnd = ax > W * 0.8;
        s += `<line x1="${ax.toFixed(1)}" x2="${ax.toFixed(1)}" y1="6" y2="${top + h}" stroke="#232323" stroke-width="1.2"/><circle cx="${ax.toFixed(1)}" cy="6" r="4" fill="#232323"/>`;
        s += t(ax + (aEnd ? -7 : 7), 10, a, aEnd ? 'end' : 'start');
        const bEnd = bx > W * 0.8;
        s += `<line x1="${bx.toFixed(1)}" x2="${bx.toFixed(1)}" y1="${top}" y2="${top + h + 8}" stroke="#232323" stroke-width="1.2"/><rect x="${(bx - 3.5).toFixed(1)}" y="${top + h + 5}" width="7" height="7" fill="#fff" stroke="#232323" stroke-width="1.4"/>`;
        s += t(bx + (bEnd ? -7 : 7), top + h + 13, b, bEnd ? 'end' : 'start');
        const el = (tag: string, cls: string, txt?: string) => { const n = document.createElement(tag); n.className = cls; if (txt != null) n.textContent = txt; return n; };
        const dot = (c: string, rr = 3.6) => `<svg viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="${rr}" fill="${c}"/></svg>`;
        const sq = '<svg viewBox="0 0 10 10" aria-hidden="true"><rect x="1.6" y="1.6" width="6.8" height="6.8" fill="#fff" stroke="#232323" stroke-width="1.4"/></svg>';
        const head = el('div', 'tt-head');
        head.append(el('strong', '', g.dataset.tip ?? ''));
        if (g.dataset.aside) { const aside = el('span', 'tt-aside'); aside.innerHTML = dot('#77756F', 2.6); aside.append(g.dataset.aside); head.append(aside); }
        const bar = el('div', 'tt-ruler');
        bar.innerHTML = `<svg viewBox="-2 0 ${W + 4} 44" aria-hidden="true">${s}</svg>`;
        const kids: HTMLElement[] = [head, bar];
        if (r.foot) {
          const f = el('div', 'tt-rfoot');
          const a1 = el('span', ''); a1.innerHTML = dot('#232323'); a1.append(r.foot[0]);
          const b1 = el('span', ''); b1.innerHTML = sq; b1.append(r.foot[1]);
          f.append(a1, b1);
          if (r.foot[2]) f.append(el('span', 'tt-rnote', r.foot[2]));
          kids.push(f);
        }
        tip.replaceChildren(...kids);
        tip.classList.add('ruler');
        tip.hidden = false;
        move(e);
        return;
      }
      if (g.dataset.kind === 'hours') {
        const vals = (g.dataset.vals ?? '').split(' ').map(Number);
        const st = cols?.dataset.state;
        const at = st && st !== 'all' ? Number(st.slice(1)) : Number(g.dataset.at ?? 0);
        const hourName = (h: number) => (h === 0 ? 'midnight' : h === 12 ? 'noon' : h < 12 ? `${h} a.m.` : `${h - 12} p.m.`);
        const el = (tag: string, cls: string, txt?: string) => { const n = document.createElement(tag); n.className = cls; if (txt != null) n.textContent = txt; return n; };
        const head = el('div', 'tt-head');
        head.append(el('strong', '', g.dataset.tip ?? ''));
        const big = el('div', 'tt-big');
        big.append(el('b', '', String(vals[at] ?? 0)), el('span', '', `${vals[at] === 1 ? 'bus leaves' : 'buses leave'} at ${hourName(at)}`));
        // the day: 24 bars on the block's own scale, the hour shown in ink; ticks at midnight, 6, noon, 6
        const W = 212, H = 34, bw = W / 24, max = Math.max(1, ...vals);
        let svg = vals.map((v, h) => `<rect x="${(h * bw + 0.6).toFixed(1)}" y="${(H - (v / max) * H).toFixed(1)}" width="${(bw - 1.2).toFixed(1)}" height="${((v / max) * H).toFixed(1)}" fill="${h === at ? '#232323' : '#CFCDC7'}"/>`).join('');
        svg += `<line x1="0" x2="${W}" y1="${H + 0.5}" y2="${H + 0.5}" stroke="#77756F" stroke-width="0.8"/>`;
        svg += [[0, '12A'], [6, '6A'], [12, '12P'], [18, '6P']].map(([h, l]) => `<text x="${(Number(h) * bw + 0.6).toFixed(1)}" y="${H + 11}" font-family="Roboto, sans-serif" font-size="9" fill="#77756F">${l}</text>`).join('');
        const bar = el('div', 'tt-ruler');
        bar.innerHTML = `<svg viewBox="0 0 ${W} ${H + 13}" aria-hidden="true">${svg}</svg>`;
        const kids: HTMLElement[] = [head, big, bar];
        for (const row of (g.dataset.detail ?? '').split('|').filter(Boolean)) kids.push(el('span', 'tt-detail', row));
        tip.replaceChildren(...kids);
        tip.classList.add('ruler');
        tip.hidden = false;
        move(e);
        return;
      }
      if (g.dataset.kind === 'card') {
        type Card = { name: string; aside?: string; mark?: { type: string; fill: string }; big?: [string, string];
          bar?: { frac: number; segs: [number, number, string][]; left?: string; right?: string }; sev?: [number, number];
          chips?: string[]; sec?: string; counts?: { type: string; fill: string; n: string; label: string }[]; foot?: [string, string] };
        let cd: Card;
        try { cd = JSON.parse(g.dataset.card ?? ''); } catch { return; }
        const el = (tag: string, cls: string, txt?: string) => { const n = document.createElement(tag); n.className = cls; if (txt != null) n.textContent = txt; return n; };
        const kids: HTMLElement[] = [];
        const head = el('div', 'tt-head');
        if (cd.mark) head.innerHTML = labelGlyph(cd.mark.type, cd.mark.fill);
        head.append(el('strong', '', cd.name));
        if (cd.aside) head.append(el('span', 'tt-aside', cd.aside));
        kids.push(head);
        if (cd.big) { const b = el('div', 'tt-big'); b.append(el('b', '', cd.big[0]), el('span', '', cd.big[1])); kids.push(b); }
        if (cd.bar) {
          // filled to frac in the map's class shades; the rest open, framed; an ink tick at the value
          const W = 236, f = Math.max(0, Math.min(1, cd.bar.frac));
          const rects = cd.bar.segs.filter(([a]) => a < f).map(([a, b, c]) => `<rect x="${(a * W).toFixed(1)}" width="${((Math.min(b, f) - a) * W).toFixed(1)}" height="9" fill="${c}"/>`).join('');
          const bar = el('div', 'tt-cbar');
          bar.innerHTML = `<svg viewBox="0 0 ${W} 9" preserveAspectRatio="none" aria-hidden="true"><rect x="0.5" y="0.5" width="${W - 1}" height="8" fill="#fff" stroke="#CFCDC7"/>${rects}<line x1="${(f * W).toFixed(1)}" x2="${(f * W).toFixed(1)}" y1="0" y2="9" stroke="#232323" stroke-width="1.2"/></svg>`;
          const lr = el('div', '');
          lr.append(el('span', '', cd.bar.left ?? ''), el('span', '', cd.bar.right ?? ''));
          bar.append(lr);
          kids.push(bar);
        }
        if (cd.sev) {
          const r = el('div', 'tt-sev');
          const pips = el('span', 'tt-pips');
          pips.innerHTML = Array.from({ length: cd.sev[1] }, (_, i) => `<i${i < cd.sev![0] ? '' : ' class="o"'}></i>`).join('');
          r.append(el('span', 'tt-cap', 'Severity'), pips, el('span', 'tt-detail', `${cd.sev[0]} of ${cd.sev[1]}`));
          kids.push(r);
        }
        if (cd.chips?.length) { const c = el('div', 'tt-chips'); cd.chips.forEach((t) => c.append(el('span', '', t))); kids.push(c); }
        if (cd.sec) kids.push(el('div', 'tt-cap', cd.sec));
        if (cd.counts?.length) {
          const c = el('div', 'tt-counts');
          for (const k of cd.counts) {
            const d = el('div', '');
            d.innerHTML = labelGlyph(k.type, k.fill);
            d.append(el('b', '', k.n), el('span', '', k.label));
            c.append(d);
          }
          kids.push(c);
        }
        if (cd.foot) { const f = el('div', 'tt-foot'); f.append(el('span', '', cd.foot[0]), el('span', '', cd.foot[1])); kids.push(f); }
        tip.replaceChildren(...kids);
        tip.classList.add('card');
        tip.hidden = false;
        move(e);
        return;
      }
      if (g.dataset.kind === 'sheet') {
        type Sheet = { num: string; name: string; sub?: string; fill: string; on: string; blocks: Record<string, any>[] };
        let sh: Sheet;
        try { sh = JSON.parse(g.dataset.sheet ?? ''); } catch { return; }
        const el = (tag: string, cls: string, txt?: string) => { const n = document.createElement(tag); n.className = cls; if (txt != null) n.textContent = txt; return n; };
        const top = el('div', 'tt-sh-head');
        Object.assign(top.style, { background: sh.fill, color: sh.on });
        top.append(el('span', 'tt-num', sh.num), el('strong', '', sh.name));
        if (sh.sub) { const s = el('span', 'tt-sh-sub', sh.sub); s.style.color = sh.on; top.append(s); }
        const kids: HTMLElement[] = [top];
        for (const b of sh.blocks) {
          if (b.sec) kids.push(el('div', 'tt-sh-sec', b.sec));
          else if (b.foot) kids.push(el('div', 'tt-sh-foot', b.foot));
          else if (b.row) {
            const [label, value, note] = b.row as string[];
            const r = el('div', 'tt-sh-row');
            const v = el('span', 'tt-sh-val');
            v.append(el('b', '', value));
            if (note) v.append(el('i', '', ` ${note}`));
            r.append(el('span', '', label), v);
            kids.push(r);
          } else if (b.bar) {
            let x = 0;
            const rects = (b.bar as [number, string][]).map(([f, c]) => {
              const s = `<rect x="${(x * 240).toFixed(1)}" width="${(f * 240).toFixed(1)}" height="8" fill="${c === 'hatch' ? 'url(#tt-hatch)' : c}"/>`;
              x += f;
              return s;
            }).join('');
            const bar = el('div', 'tt-sh-bar');
            bar.innerHTML = `<svg viewBox="0 0 240 8" preserveAspectRatio="none" aria-hidden="true"><defs><pattern id="tt-hatch" width="2.4" height="2.4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="2.4" height="2.4" fill="#F1F0EC"/><line x1="0" y1="0" x2="0" y2="2.4" stroke="#232323" stroke-width="0.7"/></pattern></defs>${rects}</svg>`;
            kids.push(bar);
          }
        }
        tip.replaceChildren(...kids);
        tip.classList.add('sheet');
        tip.hidden = false;
        move(e);
        return;
      }
      if (g.dataset.kind === 'cluster') {
        const n = (k: string) => Number(g.dataset[k] ?? 0);
        const [bw, bb, dw, db] = (g.dataset.colors ?? '').split('|')[isColor() ? 1 : 0]?.split(' ') ?? []; // grayscale | color
        const num = document.createElement('span');
        num.className = 'tt-num';
        num.textContent = g.dataset.rank ?? '';
        const area = document.createElement('span');
        area.className = 'tt-ca';
        area.textContent = `· ${g.dataset.ca ?? ''}`;
        head.append(num, name, area);
        const total = document.createElement('span');
        total.textContent = g.dataset.total ?? '';
        // the bar on the cluster's own scale; deaths as dots under their part of it
        const W = 200, s = W / (n('walk') + n('bike'));
        const dots = (count: number, x0: number, fill: string) =>
          Array.from({ length: count }, (_, i) => `<circle cx="${(x0 + 3.5 + i * 6.5).toFixed(1)}" cy="14" r="2.4" fill="${fill}"/>`).join('');
        const killed = n('kw') + n('kb');
        const bar = document.createElement('div');
        bar.className = 'tt-bar';
        bar.innerHTML = `<svg viewBox="0 0 ${W} ${killed ? 17.5 : 8}" aria-hidden="true"><rect width="${(n('walk') * s).toFixed(1)}" height="8" fill="${bw}"/><rect x="${(n('walk') * s).toFixed(1)}" width="${(n('bike') * s).toFixed(1)}" height="8" fill="${bb}"/>${dots(n('kw'), 0, dw)}${dots(n('kb'), n('walk') * s, db)}</svg>`;
        const counts = document.createElement('span');
        counts.className = 'tt-detail';
        counts.innerHTML = `<i class="tt-sw" style="background:${bw}"></i>${n('walk')} walking <i class="tt-sw" style="background:${bb}"></i>${n('bike')} biking`;
        const dead = document.createElement('span');
        dead.className = 'tt-detail';
        // the killed dots in the map's colors: ink in grayscale, the mode's color in color
        const dot = (fill: string) => `<svg class="tt-dot" viewBox="0 0 6 6" aria-hidden="true"><circle cx="3" cy="3" r="2.4" fill="${fill}"/></svg>`;
        if (killed) dead.innerHTML = `${killed} killed: ${dot(dw)}${n('kw')} walking ${dot(db)}${n('kb')} biking`;
        else dead.textContent = 'No one killed';
        const rows = (g.dataset.detail ?? '').split('|').filter(Boolean).map((t) => {
          const row = document.createElement('span');
          row.className = 'tt-detail';
          row.textContent = t;
          return row;
        });
        tip.replaceChildren(head, total, bar, counts, dead, ...rows);
        tip.hidden = false;
        move(e);
        return;
      }
      head.innerHTML = mark(g.dataset.ada === '1', (g.dataset.lines ?? '').split(' ').filter(Boolean), g.dataset.shape, g.dataset);
      head.append(name);
      const rows = (g.dataset.detail ?? '').split('|').filter(Boolean).map((t) => {
        const row = document.createElement('span');
        row.className = 'tt-detail';
        row.textContent = t;
        return row;
      });
      tip.replaceChildren(head, lines, ...rows);
      tip.hidden = false;
      move(e);
    };
    fig.addEventListener('pointerover', (e) => {
      const t = e.target as Element;
      const g = t.closest<HTMLElement>('[data-tip]');
      if (g) show(g, e);
      else tip.hidden = true;
      pick(g?.dataset.id ?? null);
      if (hoverable(t)) highlight(keysOf(t));
    });
    fig.addEventListener('pointermove', (e) => { if (!tip.hidden) move(e); });
    fig.addEventListener('pointerout', (e) => {
      if (e.pointerType === 'touch') return; // touch keeps the last tap until the next one
      const t = e.target as Element;
      const to = e.relatedTarget as Element | null;
      const g = t.closest('[data-tip]');
      if (g && !g.contains(to)) {
        tip.hidden = true;
        pick(to?.closest<HTMLElement>('[data-id]')?.dataset.id ?? null);
      }
      const h = hoverable(t);
      if (h && !h.contains(to)) highlight(to && hoverable(to) ? keysOf(to) : null);
    });
    // raising a picked station moves it in the DOM, which can swallow its pointerout; clear on leaving the figure
    fig.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'touch') return;
      tip.hidden = true;
      pick(null);
      highlight(null);
    });
    fig.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'touch') return;
      const t = e.target as Element;
      if (!t.closest('[data-tip]')) { tip.hidden = true; pick(null); }
      if (!hoverable(t)) highlight(null);
    });
  });

  // States (Plate XIII): a renderer may draw several versions of its map as groups [data-state="key"],
  // all but "all" hidden, and give a chart [data-state-host] controls [data-state-key="key"]. Hovering
  // or tapping a control shows its state on every page SVG; leaving the chart (or blurring it) returns
  // to "all". With the chart focused, the arrow keys step through the controls.
  const hosts = [...document.querySelectorAll<SVGSVGElement>('[data-state-host]')];
  if (hosts.length) {
    const setState = (key: string) => {
      if (cols) cols.dataset.state = key; // the hours tooltip (Plate XVII) reads the hour shown
      cols?.querySelectorAll('[data-state]').forEach((g) => {
        if (g.getAttribute('data-state') === key) g.removeAttribute('display');
        else g.setAttribute('display', 'none');
      });
      cols?.querySelectorAll('[data-state-key]').forEach((c) => c.classList.toggle('on', c.getAttribute('data-state-key') === key));
    };
    for (const host of hosts) {
      const controls = [...host.querySelectorAll('[data-state-key]')];
      let at = -1;
      host.addEventListener('pointerover', (e) => {
        const c = (e.target as Element).closest('[data-state-key]');
        if (!c) return;
        at = controls.indexOf(c);
        setState(c.getAttribute('data-state-key')!);
      });
      host.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'touch') setState('all'); });
      host.addEventListener('blur', () => setState('all'));
      host.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        at = (at + (e.key === 'ArrowRight' ? 1 : controls.length - 1) + (at < 0 && e.key === 'ArrowLeft' ? 1 : 0)) % controls.length;
        setState(controls[at].getAttribute('data-state-key')!);
      });
    }
    // touch keeps the last tapped hour until a tap outside every chart
    document.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch' && !hosts.some((h) => h.contains(e.target as Node))) setState('all');
    });
  }
</script>

<style>
  .daynav { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  /* Home in the middle; the first plate has no Prev, and its empty slot keeps Home centred */
  .daynav .links { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 18px; font-size: 11px; }
  .daynav .prev { justify-self: end; }
  .daynav .next { justify-self: start; }
  @media (max-width: 900px) { .daynav { flex-basis: 100%; order: 3; } } /* own row, under brand and toggle */
  .daynav .links a { font-weight: 600; } /* Home, and Prev/Next once there is a page to go to */
  .daynav .where { margin: 0; font-size: 10px; }
  .daynav a { text-decoration: none; }
  .daynav a:hover { text-decoration: underline; }
  .daynav .off { color: var(--fog); }

  /* Three columns: the map and the middle column (24px of vertical padding; the middle column adds
     44px of side padding) at the widths set above, so the story panel takes the same rest on every
     page as on Plate I, up to a readable 560px. */
  .plate-view { flex: 1; min-height: 0; container-type: size; }
  .cols {
    height: 100%; display: grid;
    grid-template-columns:
      minmax(0, calc((100cqh - 24px) * var(--map-ratio)))
      minmax(0, calc((100cqh - 24px) * var(--side-ratio) + 44px))
      minmax(340px, 1fr);
  }

  .viz { position: relative; margin: 0; min-height: 0; padding: 12px 0; }
  .map { padding-right: 16px; }
  .map > div:not(.tip):not(.mapctl) { height: 100%; }
  .viz :global(svg) { display: block; width: 100%; height: 100%; overflow: visible; } /* first grid label sits half outside */
