---
import Base from '../../layouts/Base.astro';
import days from '../../data/days.json';
import { plates } from '../../plates/index.js';
import { LINES } from '../../lib/plate.js';

export function getStaticPaths() {
  return days
    .filter((d) => d.status === 'published' && plates[d.day])
    .map((d) => ({ params: { slug: `day${String(d.day).padStart(2, '0')}` }, props: { d } }));
}

const { d } = Astro.props;
const base = import.meta.env.BASE_URL;
const p = plates[d.day];
const both = (variant) => ({ gray: p.render({ variant }), color: p.render({ mode: 'color', variant }) });
const maps = both('map');
const charts = both('chart');
const insets = both('inset');
// Column widths, as multiples of the column height. On Plate I the map column is as wide as the map
// draws at full height and the middle column as wide as the chart plus a ~330-unit inset would draw
// at full height; the story takes the rest. Every page keeps Plate I's story width: its map column
// is as wide as its map draws at full height, and its middle column takes the rest of the width
// Plate I's two columns take (the chart scales with the column; the inset fills what is left).
const vb = (svg) => svg.match(/viewBox="([^"]+)"/)[1].split(' ').map(Number);
const ratios = (map, chart) => {
  const [, , mw, mh] = vb(map), [, , cw, ch] = vb(chart);
  return [mw / mh, cw / (ch + 330 + 70)]; // + HTML headers and notes
};
const [mapRatio, sideRatio] = (() => {
  const [m, s] = ratios(maps.gray, charts.gray);
  const [m1, s1] = d.day === 1 ? [m, s] : ratios(plates[1].render({ variant: 'map' }), plates[1].render({ variant: 'chart' }));
  return [m.toFixed(4), (m1 + s1 - m).toFixed(4)];
})();
// Tooltip line boxes take the line's color in color mode, as in the chart.
const lineCss = Object.entries(LINES).map(([k, c]) => `html[data-mode='color'] .tt-line[data-line='${k}'] { background: ${c}; color: #fff; }`).join('\n');
const pad = (n) => String(n).padStart(2, '0');
const slug = (n) => `day${pad(n)}`;
const published = days.filter((x) => x.status === 'published' && plates[x.day]).map((x) => x.day);
const prev = published.filter((n) => n < d.day).at(-1);
const next = published.find((n) => n > d.day);
const chapters = ['The Grid', 'The Systems', 'The Gaps', 'The Body', 'The Possible'];
const numerals = ['I', 'II', 'III', 'IV', 'V'];
const chapter = `Chapter ${numerals[chapters.indexOf(d.chapter)]}: ${d.chapter}`;
const date = new Date(d.date + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const dl = `${base}downloads/${p.file}`;
// story sections in panel order: a plate's own list (story.sections: [heading, paragraphs, open?]),
// or Background, Findings (open) and The plan
const sections = p.story.sections ?? [['Background', p.story.background], ['Findings', p.story.findings, true], ['The plan', p.story.plan]].filter(([, paras]) => paras);
// saved file name, either mode: DAY01-POINTS.svg, DAY01-POINTS.png
const saveName = `DAY${pad(d.day)}-${d.theme.toUpperCase().replace(/[^A-Z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---
<Base title={`Plate ${d.plate} · ${d.title} — 800 to the Mile`} description={p.story.findings[0]} app>
  <nav class="daynav" slot="nav" aria-label="Plates">
    <div class="links sans">
      {prev ? <a class="prev" href={`${base}${slug(prev)}/`}>← Day {pad(prev)}</a> : <span class="prev" />}
      <a href={base}>Home</a>
      {next ? <a class="next" href={`${base}${slug(next)}/`}>Day {pad(next)} →</a> : <span class="next off">Next →</span>}
    </div>
    <p class="where sans quiet">{chapter} · Plate {d.plate}</p>
  </nav>

  <main class="plate-view">
   <div class="cols" style={`--map-ratio: ${mapRatio}; --side-ratio: ${sideRatio}`} data-line-colors={JSON.stringify(LINES)}>
    <figure class="viz map">
      <div class="only-gray" set:html={maps.gray} />
      <div class="only-color" set:html={maps.color} />
      <div class="tip" role="tooltip" hidden></div>
      <div class="mapctl">
        <button type="button" data-map="full" aria-label="Show the map full screen" aria-pressed="false" title="Full screen"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 8V3.5H8M12 3.5h4.5V8M16.5 12v4.5H12M8 16.5H3.5V12"/></svg></button>
      </div>
    </figure>
    <figure class="viz side">
      <div class="chart">
        <p class="col-title sans">{p.page.chart.title}</p>
        <p class="col-note">{p.page.chart.note}{p.page.chart.colorNote && <span class="only-color">{p.page.chart.colorNote}</span>}</p>
        <div class="only-gray" set:html={charts.gray} />
        <div class="only-color" set:html={charts.color} />
      </div>
      <div class="inset">
        <p class="col-title sans">{p.page.inset.title}</p>
        <p class="col-note">Shown at <span data-inset-scale>×2</span> the scale of the main map.</p>
        <div class="inset-box">
          <div class="only-gray" set:html={insets.gray} />
          <div class="only-color" set:html={insets.color} />
        </div>
      </div>
      <div class="tip" role="tooltip" hidden></div>
    </figure>

    <aside class="panel">
      <p class="meta sans quiet"><span>Day {pad(d.day)} · {d.theme} · {date}</span></p>
      <h1>{d.title}</h1>
      <p class="subtitle">{p.subtitle}</p>
      <p class="finding">{p.finding}</p>

      {sections.map(([heading, paras, open]) => (
        <details name="plate" open={open}>
          <summary class="sans">{heading}</summary>
          <div class="body">{paras.map((t) => <p>{t}</p>)}</div>
        </details>
      ))}
      <details name="plate">
        <summary class="sans">Data and method</summary>
        <dl class="body ledger">
          {p.ledger.map(([k, v, url]) => (
            <Fragment><dt class="sans quiet">{k}</dt><dd>{Array.isArray(v) ? v.map(([t, u], i) => <Fragment>{i > 0 && ' · '}<a href={u}>{t}</a></Fragment>) : url ? <a href={url}>{v}</a> : v}</dd></Fragment>
          ))}
        </dl>
      </details>
      <details name="plate">
        <summary class="sans">Download</summary>
        <ul class="body downloads">
          <li class="only-gray"><a href={`${dl}.svg`} download={`${saveName}.svg`}>Plate {d.plate} (SVG)</a><span class="quiet">Vector, fonts embedded</span></li>
          <li class="only-color"><a href={`${dl}-color.svg`} download={`${saveName}.svg`}>Plate {d.plate} (SVG)</a><span class="quiet">Vector, fonts embedded</span></li>
          <li class="only-gray"><a href={`${dl}.png`} download={`${saveName}.png`}>Plate {d.plate} (PNG)</a><span class="quiet">3240 × 4050 px, 300 DPI</span></li>
          <li class="only-color"><a href={`${dl}-color.png`} download={`${saveName}.png`}>Plate {d.plate} (PNG)</a><span class="quiet">3240 × 4050 px, 300 DPI</span></li>
        </ul>
      </details>
    </aside>
   </div>
  </main>
</Base>

<Fragment set:html={`<style>${lineCss}</style>`} />

<script>
  // Hover hooks emitted by the map, chart and inset variants of each plate renderer:
  //   [data-tip][data-name][data-lines][data-ada][data-detail]  tooltip (a station, or a walkshed with
  //        data-kind=area: dot or ring, line boxes, then detail rows split on '|')
  //   [data-kind=route][data-detail][data-sep][data-dash][data-gray][data-color][data-on-color]
  //        tooltip for a route: route box and name, a rule data-sep px thick, one sentence
  //   [data-kind=cluster][data-rank][data-ca][data-total][data-walk][data-bike][data-kw][data-kb][data-colors: 'gray four | color four']
  //        tooltip for a cluster (Plate IV): number box, name and area, total, a walking / biking bar
  //        with the deaths as dots under their part of it, the counts, then the detail rows
  //   [data-hl] (chart row) / [data-keys] (station, label)  highlight one line set, fade the rest
  // Highlighting spans every page SVG, so a line row in the chart lights its stations on the map.
  const cols = document.querySelector<HTMLElement>('.cols');
  const visible = (sel: string) =>
    [...document.querySelectorAll<SVGSVGElement>(sel)].filter((el) => el.getBoundingClientRect().width > 0);
  const scale = (svg: SVGSVGElement, slice = false) => {
    const r = svg.getBoundingClientRect();
    const vb = svg.viewBox.baseVal;
    return (slice ? Math.max : Math.min)(r.width / vb.width, r.height / vb.height);
  };

  // Set the chart title on the same line as the top of the map's grid labels, then state the
  // inset's scale relative to the map. The map SVG gives, in viewBox units from its top: data-top (grid
  // labels), data-ftop (map field), data-bottom (bottom grid line); and data-ppm, px per mile.
  const chartBox = document.querySelector<HTMLElement>('.side .chart');
  const layout = () => {
    const [map] = visible('.map svg');
    const title = chartBox?.querySelector<HTMLElement>('.col-title');
    const [inset] = visible('.inset-box svg');
    const side = document.querySelector<HTMLElement>('.side');
    const insetBox = document.querySelector<HTMLElement>('.inset-box');
    if (chartBox) chartBox.style.marginTop = '';
    if (side) side.style.paddingBottom = '';
    if (map && title && chartBox && !matchMedia('(max-width: 900px)').matches) {
      const mapTop = map.getBoundingClientRect().top + Number(map.dataset.top) * scale(map);
      const r = title.getBoundingClientRect();
      const capTop = r.top + (r.height - parseFloat(getComputedStyle(title).fontSize) * 0.7) / 2; // cap height ≈ 0.7 em
      chartBox.style.marginTop = `${Math.max(-12, mapTop - capTop)}px`;
      // and end the inset box on the map's bottom grid line, unless that leaves the inset shorter
      // than half its width; then it keeps that height and ends below the map
      if (side && insetBox && map.dataset.bottom) {
        const mapBottom = map.getBoundingClientRect().top + Number(map.dataset.bottom) * scale(map);
        const box = insetBox.getBoundingClientRect();
        const gap = Math.min(box.bottom - mapBottom, Math.max(0, box.height - box.width / 2));
        side.style.paddingBottom = `${Math.max(0, parseFloat(getComputedStyle(side).paddingBottom) + gap)}px`;
      }
    }
    // the full-screen button in the top-left corner of the map's field (its left edge is the viewBox's;
    // its top, data-ftop); full screen centres the map, so its left edge moves by half the spare width
    const ctl = document.querySelector<HTMLElement>('.mapctl');
    if (map && ctl && map.dataset.ftop) {
      const r = map.getBoundingClientRect(), f = map.closest('figure')!.getBoundingClientRect();
      const s = scale(map);
      const dx = map.getAttribute('preserveAspectRatio')?.startsWith('xMid') ? (r.width - map.viewBox.baseVal.width * s) / 2 : 0;
      ctl.style.left = `${r.left - f.left + dx + 8}px`;
      ctl.style.top = `${r.top - f.top + Number(map.dataset.ftop) * s + 8}px`;
    }
    const out = document.querySelector('[data-inset-scale]');
    if (map && inset && out && map.dataset.ppm && inset.dataset.ppm) {
      const n = (scale(inset, true) * Number(inset.dataset.ppm)) / (scale(map) * Number(map.dataset.ppm));
      out.textContent = `×${Number(n.toFixed(n < 10 ? 1 : 0))}`;
    }
    // A cropped inset (data-north) shows less than the plate's box: move the map's outline to the
    // miles actually in view, and pin labels marked data-pin-bottom to the crop's bottom edge.
    if (map && inset && map.dataset.ppm && inset.dataset.ppm && inset.dataset.north) {
      const vb = inset.viewBox.baseVal;
      const shown = inset.getBoundingClientRect().height / scale(inset, true); // viewBox units in view
      const top = (vb.height - shown) / 2;
      const ki = Number(inset.dataset.ppm);
      const north = Number(inset.dataset.north) - top / ki;
      const south = north - shown / ki;
      // both modes' maps, so the outline is already right when the mode toggle swaps them
      document.querySelectorAll<SVGRectElement>('.map [data-inset-frame]').forEach((frame) => {
        const k = Number(frame.closest<SVGSVGElement>('svg')?.dataset.ppm);
        const y0 = Number(frame.dataset.y0);
        frame.setAttribute('y', `${y0 - north * k}`);
        frame.setAttribute('height', `${(north - south) * k}`);
      });
      document.querySelectorAll('.inset-box [data-pin-bottom]').forEach((g) => g.setAttribute('transform', `translate(0 ${top + shown})`));
    }
  };
  // Full screen shows the map figure alone, centred on paper.
  const mapFig = document.querySelector<HTMLElement>('.map')!;
  const mapSvgs = [...mapFig.querySelectorAll<SVGSVGElement>(':scope > div:not(.tip):not(.mapctl) > svg')];
  type FsDoc = Document & { webkitFullscreenElement?: Element; webkitExitFullscreen?: () => void; webkitFullscreenEnabled?: boolean };
  type FsEl = HTMLElement & { webkitRequestFullscreen?: () => void };
  const fsDoc = document as FsDoc;
  const full = mapFig.querySelector<HTMLButtonElement>("[data-map='full']")!;
  if (!(fsDoc.fullscreenEnabled || fsDoc.webkitFullscreenEnabled)) full.parentElement!.hidden = true; // e.g. iPhone
  full.addEventListener('click', () => {
    if (fsDoc.fullscreenElement ?? fsDoc.webkitFullscreenElement) (fsDoc.exitFullscreen?.bind(fsDoc) ?? fsDoc.webkitExitFullscreen?.bind(fsDoc))?.();
    else ((mapFig as FsEl).requestFullscreen?.bind(mapFig) ?? (mapFig as FsEl).webkitRequestFullscreen?.bind(mapFig))?.();
  });
  const onFull = () => {
    const on = (fsDoc.fullscreenElement ?? fsDoc.webkitFullscreenElement) === mapFig;
    full.setAttribute('aria-pressed', String(on));
    full.setAttribute('aria-label', on ? 'Leave full screen' : 'Show the map full screen');
    for (const svg of mapSvgs) svg.setAttribute('preserveAspectRatio', on ? 'xMidYMid meet' : 'xMinYMin meet');
    requestAnimationFrame(layout);
  };
  document.addEventListener('fullscreenchange', onFull);
  document.addEventListener('webkitfullscreenchange', onFull);

  layout();
  addEventListener('resize', layout);
  document.fonts?.ready.then(layout);
  document.querySelectorAll('[data-set-mode]').forEach((b) => b.addEventListener('click', () => requestAnimationFrame(layout)));

  // keys: the lines to light, or null to clear.
  const highlight = (keys: string[] | null) => {
    cols?.querySelectorAll('.map > div:not(.tip) > svg, .chart svg, .inset-box svg').forEach((svg) => {
      svg.classList.toggle('hl', Boolean(keys));
      if (!keys) return;
      svg.querySelectorAll('[data-keys]').forEach((n) => n.classList.toggle('on', n.getAttribute('data-keys')!.split(' ').some((k) => keys.includes(k))));
      svg.querySelectorAll('[data-hl]').forEach((n) => n.classList.toggle('on', keys.includes(n.getAttribute('data-hl')!)));
    });
  };
  // A chart row lights its own line; a station on the map or inset lights all of its lines.
  const keysOf = (t: Element) => {
    const h = t.closest('[data-hl]');
    if (h) return [h.getAttribute('data-hl')!];
    const g = t.closest('[data-tip]');
    const lines = g?.getAttribute('data-lines');
    return lines ? lines.split(' ') : null;
  };
  const hoverable = (t: Element) => t.closest('[data-hl], [data-tip][data-lines]');
  // The hovered station grows wherever it appears: map, inset and every chart row it is on.
  // ...and its dot, with its name, is drawn above everything else on the map and inset
  const pick = (id: string | null) => {
    cols?.querySelectorAll('g.pick').forEach((g) => g.classList.remove('pick'));
    if (!id) return;
    cols?.querySelectorAll(`g[data-id="${id}"]`).forEach((g) => g.classList.add('pick'));
    cols?.querySelectorAll(`.map svg [data-id="${id}"], .inset-box svg [data-id="${id}"]`).forEach((el) => {
      el.parentNode?.appendChild(el); // later in the document draws on top
    });
  };

  // The tooltip's dot or ring follows the map: ink in grayscale; in color, the station's line color,
  // or ink for stations on two or more lines.
  const lineColors: Record<string, string> = JSON.parse(cols?.dataset.lineColors ?? '{}');
  const isColor = () => document.documentElement.dataset.mode === 'color';
  const mark = (ada: boolean, lines: string[]) => {
    const color = isColor();
    const c = color && lines.length === 1 ? lineColors[lines[0]] ?? '#232323' : color ? '#232323' : '#5A5853'; // grayscale marks are softened
    return ada
      ? `<svg viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="4" fill="${c}"/></svg>`
      : `<svg viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="3.6" fill="#F1F0EC" stroke="${c}" stroke-width="1.2"/></svg>`;
  };

  document.querySelectorAll<HTMLElement>('.viz').forEach((fig) => {
    const tip = fig.querySelector<HTMLElement>('.tip')!;
    const move = (e: PointerEvent) => {
      const r = fig.getBoundingClientRect();
      let x = e.clientX - r.left + 14;
      let y = e.clientY - r.top + 14;
      if (x + tip.offsetWidth > r.width) x -= tip.offsetWidth + 28;
      if (y + tip.offsetHeight > r.height) y -= tip.offsetHeight + 28;
      tip.style.transform = `translate(${x}px, ${y}px)`;
    };
    const show = (g: HTMLElement, e: PointerEvent) => {
      const route = g.dataset.kind === 'route';
      const head = document.createElement('div');
      head.className = 'tt-head';
      const name = document.createElement('strong');
      name.textContent = g.dataset.name ?? g.dataset.tip ?? '';
      const lines = document.createElement('div');
      lines.className = 'tt-lines';
      for (const l of (g.dataset.lines ?? '').split(' ').filter(Boolean)) {
        const box = document.createElement('span');
        box.className = 'tt-line';
        box.dataset.line = l;
        box.textContent = l;
        if (route && isColor() && g.dataset.color) Object.assign(box.style, { background: g.dataset.color, color: g.dataset.onColor ?? '#fff' });
        lines.append(box);
      }
      if (route) {
        // route box, then name; a rule as thick as the route's riders; then one sentence
        head.append(...lines.children, name);
        const c = (isColor() ? g.dataset.color : g.dataset.gray) ?? '#232323';
        const w = g.dataset.sep ?? '2';
        const rule = document.createElement('div');
        rule.className = 'tt-sep';
        rule.innerHTML = `<svg viewBox="0 0 200 9" preserveAspectRatio="none" aria-hidden="true"><line x1="0" x2="200" y1="4.5" y2="4.5" stroke="${c}" stroke-width="${w}"${g.dataset.dash ? ' stroke-dasharray="6 4"' : ''} vector-effect="non-scaling-stroke"/></svg>`;
        const text = document.createElement('span');
        text.className = 'tt-detail';
        text.textContent = g.dataset.detail ?? '';
        tip.replaceChildren(head, rule, text);
        tip.hidden = false;
        move(e);
        return;
      }
      if (g.dataset.kind === 'cluster') {
        const n = (k: string) => Number(g.dataset[k] ?? 0);
        const [bw, bb, dw, db] = (g.dataset.colors ?? '').split('|')[isColor() ? 1 : 0]?.split(' ') ?? []; // grayscale | color
        const num = document.createElement('span');
        num.className = 'tt-num';
        num.textContent = g.dataset.rank ?? '';
        const area = document.createElement('span');
        area.className = 'tt-ca';
        area.textContent = `· ${g.dataset.ca ?? ''}`;
        head.append(num, name, area);
        const total = document.createElement('span');
        total.textContent = g.dataset.total ?? '';
        // the bar on the cluster's own scale; deaths as dots under their part of it
        const W = 200, s = W / (n('walk') + n('bike'));
        const dots = (count: number, x0: number, fill: string) =>
          Array.from({ length: count }, (_, i) => `<circle cx="${(x0 + 3.5 + i * 6.5).toFixed(1)}" cy="14" r="2.4" fill="${fill}"/>`).join('');
        const killed = n('kw') + n('kb');
        const bar = document.createElement('div');
        bar.className = 'tt-bar';
        bar.innerHTML = `<svg viewBox="0 0 ${W} ${killed ? 17.5 : 8}" aria-hidden="true"><rect width="${(n('walk') * s).toFixed(1)}" height="8" fill="${bw}"/><rect x="${(n('walk') * s).toFixed(1)}" width="${(n('bike') * s).toFixed(1)}" height="8" fill="${bb}"/>${dots(n('kw'), 0, dw)}${dots(n('kb'), n('walk') * s, db)}</svg>`;
        const counts = document.createElement('span');
        counts.className = 'tt-detail';
        counts.innerHTML = `<i class="tt-sw" style="background:${bw}"></i>${n('walk')} walking <i class="tt-sw" style="background:${bb}"></i>${n('bike')} biking`;
        const dead = document.createElement('span');
        dead.className = 'tt-detail';
        // the killed dots in the map's colors: ink in grayscale, the mode's color in color
        const dot = (fill: string) => `<svg class="tt-dot" viewBox="0 0 6 6" aria-hidden="true"><circle cx="3" cy="3" r="2.4" fill="${fill}"/></svg>`;
        if (killed) dead.innerHTML = `${killed} killed: ${dot(dw)}${n('kw')} walking ${dot(db)}${n('kb')} biking`;
        else dead.textContent = 'No one killed';
        const rows = (g.dataset.detail ?? '').split('|').filter(Boolean).map((t) => {
          const row = document.createElement('span');
          row.className = 'tt-detail';
          row.textContent = t;
          return row;
        });
        tip.replaceChildren(head, total, bar, counts, dead, ...rows);
        tip.hidden = false;
        move(e);
        return;
      }
      head.innerHTML = mark(g.dataset.ada === '1', (g.dataset.lines ?? '').split(' ').filter(Boolean));
      head.append(name);
      const rows = (g.dataset.detail ?? '').split('|').filter(Boolean).map((t) => {
        const row = document.createElement('span');
        row.className = 'tt-detail';
        row.textContent = t;
        return row;
      });
      tip.replaceChildren(head, lines, ...rows);
      tip.hidden = false;
      move(e);
    };
    fig.addEventListener('pointerover', (e) => {
      const t = e.target as Element;
      const g = t.closest<HTMLElement>('[data-tip]');
      if (g) show(g, e);
      else tip.hidden = true;
      pick(g?.dataset.id ?? null);
      if (hoverable(t)) highlight(keysOf(t));
    });
    fig.addEventListener('pointermove', (e) => { if (!tip.hidden) move(e); });
    fig.addEventListener('pointerout', (e) => {
      if (e.pointerType === 'touch') return; // touch keeps the last tap until the next one
      const t = e.target as Element;
      const to = e.relatedTarget as Element | null;
      const g = t.closest('[data-tip]');
      if (g && !g.contains(to)) {
        tip.hidden = true;
        pick(to?.closest<HTMLElement>('[data-id]')?.dataset.id ?? null);
      }
      const h = hoverable(t);
      if (h && !h.contains(to)) highlight(to && hoverable(to) ? keysOf(to) : null);
    });
    // raising a picked station moves it in the DOM, which can swallow its pointerout; clear on leaving the figure
    fig.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'touch') return;
      tip.hidden = true;
      pick(null);
      highlight(null);
    });
    fig.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'touch') return;
      const t = e.target as Element;
      if (!t.closest('[data-tip]')) { tip.hidden = true; pick(null); }
      if (!hoverable(t)) highlight(null);
    });
  });
</script>

<style>
  .daynav { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  /* Home in the middle; the first plate has no Prev, and its empty slot keeps Home centred */
  .daynav .links { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 18px; font-size: 11px; }
  .daynav .prev { justify-self: end; }
  .daynav .next { justify-self: start; }
  @media (max-width: 900px) { .daynav { flex-basis: 100%; order: 3; } } /* own row, under brand and toggle */
