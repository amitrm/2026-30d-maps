---
import '../styles/global.css';
interface Props { title: string; description?: string; bare?: boolean }
const { title, description = 'A Chicago access atlas in 30 plates for #30DayMapChallenge 2026.', bare = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class={bare ? 'bare' : ''}>
    {bare ? <slot /> : (
      <div class="wrap">
        <header class="topbar">
          <a href={base} class="mono">800 to the Mile</a>
          <span class="mono quiet">#30DayMapChallenge 2026 · Chicago</span>
        </header>
        <slot />
        <footer class="foot mono quiet">
          <span>Amit · <a href="https://github.com/amitrm/2026-30d-maps">source on GitHub</a></span>
          <span>Open data · grayscale only</span>
        </footer>
      </div>
    )}
  </body>
</html>
<style>
  .foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; border-top: 1px solid var(--ink); padding: 18px 0 40px; margin-top: 64px; font-size: 11px; }
  body.bare { background: var(--paper); }
</style>
