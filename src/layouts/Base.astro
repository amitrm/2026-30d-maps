---
import '../styles/global.css';
// app: full-viewport page with no footer and no page scroll (plate pages).
// masthead: false drops the site header (the landing page's hero already names the site).
interface Props { title: string; description?: string; bare?: boolean; app?: boolean; masthead?: boolean }
const { title, description = 'A Chicago access atlas in 30 plates for #30DayMapChallenge 2026.', bare = false, app = false, masthead = true } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en" data-mode="gray">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try { if (localStorage.getItem('atlas-mode') === 'color') document.documentElement.dataset.mode = 'color'; } catch (e) {}
    </script>
  </head>
  <body class={bare ? 'bare' : app ? 'app' : ''}>
    {bare ? <slot /> : (
      <div class={app ? 'wrap app' : 'wrap'}>
        {masthead && <header class="masthead">
          <a href={base} class="brand">
            <span class="brand-name">800 to the Mile</span>
            <span class="sans quiet">#30DayMapChallenge 2026 · Chicago · Amit Mondal</span>
          </a>
          <slot name="nav" />
          <div class="modes sans" role="group" aria-label="Map colors">
            <button type="button" data-set-mode="gray" aria-pressed="true">Grayscale</button>
            <button type="button" data-set-mode="color" aria-pressed="false">Color</button>
          </div>
        </header>}
        <slot />
        {!app && (
          <footer class="foot sans quiet">
            <span>© Amit Mondal</span>
          </footer>
        )}
      </div>
    )}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const buttons = document.querySelectorAll('[data-set-mode]');
        const sync = () => buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setMode === root.dataset.mode)));
        buttons.forEach((b) => b.addEventListener('click', () => {
          root.dataset.mode = b.dataset.setMode;
          try { localStorage.setItem('atlas-mode', b.dataset.setMode); } catch (e) {}
          sync();
        }));
        sync();
      })();
    </script>
  </body>
</html>
<style>
  .foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; border-top: 1px solid var(--ink); padding: 18px 0 40px; margin-top: 64px; font-size: 11px; }
  body.bare { background: var(--paper); }
</style>
